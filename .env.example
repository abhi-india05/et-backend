# Runtime mode
ENVIRONMENT=production

# Core services
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
GEMINI_API_KEY=your-gemini-key

# Auth hardening
AUTH_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
AUTH_REFRESH_COOKIE_PATH=/

# CORS for frontend deployment(s)
CORS_ORIGINS=https://your-frontend-project.vercel.app
# Optional: include preview deployments with regex matching
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# SendGrid for deployed environments
SENDGRID_API_KEY=your_sendgrid_api_key
SENDER_EMAIL=your_verified_email@gmail.com
